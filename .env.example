# Gemini AI
GEMINI_API_KEY=""

# Resend email delivery — server-side only. Use a sender/domain verified in Resend.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Public application URL (no secrets)
APP_URL="http://localhost:3000"

# Shwary merchant credentials — configure only in your local .env
# or the hosting provider's server-side secret manager.
# NEVER put real values in GitHub, frontend code, screenshots or logs.
SHWARY_MERCHANT_ID=""
SHWARY_MERCHANT_KEY=""
SHWARY_BASE_URL="https://api.shwary.com"
# sandbox is the safe default. Change to production only after provider approval.
SHWARY_MODE="sandbox"
# Optional in Sandbox; required in production. Use a public HTTPS URL.
SHWARY_CALLBACK_URL=""
# Example: https://your-domain.com/api/v1/payments/shwary/callback

# PayPal credentials will be added later as server-side secrets only.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_WEBHOOK_ID=""
